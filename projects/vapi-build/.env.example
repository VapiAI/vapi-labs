# Copy to .env and fill in your own values. Never commit real keys.
#
# The skill's CLI reads VAPI_API_KEY from the environment first, then from ~/.config/vapi-build/env.
# It can copy a key from this file without ever printing it:
#   scripts/vapi-build secrets set VAPI_API_KEY --from-file .env --var VAPI_API_KEY --verify
VAPI_API_KEY=

# Optional: AWS profile used when a source lives on s3://
AWS_PROFILE=
