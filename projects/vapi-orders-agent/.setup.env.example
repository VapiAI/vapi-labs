# Copy to .setup.env, fill in real server-side values, and run: chmod 600 .setup.env
# Account-scoped custom token: Developer Platform -> Workers Scripts Write and D1 Write.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
VAPI_API_KEY=

# Optional. Setup generates and caches a 256-bit Worker token if omitted.
ORDERS_API_TOKEN=

# Optional canonical production origin when workers.dev is disabled.
WORKER_BASE_URL=
