# Required
OPENAI_API_KEY=
HUME_API_KEY=
# Any long random string. The assistant sends it as the x-demo-secret header.
DEMO_SECRET=

# Escalation target in E.164, e.g. +15551234567. Leave empty to turn escalation off.
SPECIALIST_NUMBER=

# "Talk to the agent" button on the dashboard (optional)
VAPI_ORG_ID=
VAPI_PRIVATE_KEY=
ASSISTANT_ID=
PUBLIC_ORIGIN=

# Tuning (defaults shown)
# LLM_MODEL=gpt-4.1
# HUME_WAIT_MS=1200
# CLIP_MAX_MS=2500
# ESCALATE_TURNS=2
# MOOD_MIN=0.25
# MOOD_MARGIN=0.05

# Save each call's events and the audio clips sent to Hume (off by default,
# because the clips are recordings of real callers)
# TRACE_DIR=./traces
# DEBUG_BODIES=1
