# Vapi private API key. Required for both examples.
VAPI_API_KEY=

# Make API token, team, and zone. Needed whenever this repo creates a Make scenario for you:
# the api-request example, unless you set MAKE_WEBHOOK_URL below, and `mcp --provision-scenario`.
# The token must be allowed to read and write scenarios and hooks.
# The team ID is in the Make URL; the zone is your Make host, such as eu2.make.com.
MAKE_API_KEY=
MAKE_TEAM_ID=
MAKE_ZONE=

# Optional. Set this to reuse a Make webhook you already have and skip creating a scenario.
MAKE_WEBHOOK_URL=

# Make MCP toolbox connection URL, Streamable HTTP. Required to run the mcp example.
MAKE_MCP_URL=
